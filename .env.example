# Dashboard login (HTTP basic auth). Set these in Netlify -> Site settings -> Environment variables.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=root123

# Where results live. With GITHUB_TOKEN set, the dashboard reads data/ from the `results` branch of GITHUB_REPO and the
# play buttons dispatch the qa-agent workflow. Without it, it reads ../data from disk and play buttons are disabled.
GITHUB_REPO=ICMarkets/icm.qa-agent
RESULTS_BRANCH=main
WORKFLOW_FILE=qa-agent.yml
WORKFLOW_REF=main
GITHUB_TOKEN=
# Optional: local data directory (defaults to ../data)
DATA_DIR=
